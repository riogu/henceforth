//? OPT -O0 -iterative
fn print: (i32) -> () {
  start_1:
    %0 = i32 %arg0
    %1 = () ()
    return %1
}
fn main: () -> () {
  start_2:
    %2 = i32 1
    %3 = i32 alloca %2
    %4 = i32 0
    store %4, %3
    jump while_cond_3
  while_cond_3:
    %6 = i32 load %3
    %7 = i32 4
    %8 = bool %6 != %7
    branch %8, while_body_4 while_end_5
  while_body_4:
    %9 = bool true
    branch %9, if_body_6 if_end_7
  if_body_6:
    jump if_end_7
  if_end_7:
    %13 = i32 load %3
    %14 = i32 1
    %15 = i32 %13 + %14
    store %15, %3
    jump while_cond_3
  while_end_5:
    %10 = i32 load %3
    %11 = () call print(%10)
    %12 = () ()
    return %12
}

//? CHECK FN "main"
//? CHECK BLOCK "while_cond_3"
//? CHECK NOT "alloca"
//? CHECK NOT "if_body_6"
//? CHECK "phi"
