//? COMPILE
fn bubble_sort: ([]i32 i32) -> ([]i32) {
    let N: i32; &= N;
    let arr: [N]i32; &= arr;
    let i: i32; @(0) &= i;

    while @(i N !=) {
        let j: i32; @(0) &= j;
        while @(j 4 i - !=) {
            if @(arr j [] arr j 1 + [] >) {
                let tmp: i32; @(arr j []) &= tmp;
                @(arr j 1 + [] j) [&]= arr;
                @(tmp j 1 +) [&]= arr;
            }
            @(j 1 +) &= j;
        }
        @(i 1 +) &= i;
    }
    @(arr);
}

fn main: () -> () {
    let arr: [5]i32;
    @(5 0) [&]= arr;
    @(3 1) [&]= arr;
    @(4 2) [&]= arr;
    @(1 3) [&]= arr;
    @(2 4) [&]= arr;

    @(arr 5) &> bubble_sort;

    &> print;
}
